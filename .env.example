# MongoDB Atlas — dedicated TaskPro database (taskpro_vg)
MONGODB_URI=
MONGODB_DB=

PORT=

# Admin seed (defaults shown). Restart the server after changing these.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_MFA_CODE=
ADMIN_NAME=

# Optional SMTP — required to email employee credentials for real
# Without these, credentials are logged to the server console + shown to admin in UI
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Optional office geofence — used to record arriving and leaving during the day
# Admin can also set this in Settings. Radius is meters (default 150).
OFFICE_LAT=
OFFICE_LNG=
OFFICE_RADIUS_M=
OFFICE_LABEL=
